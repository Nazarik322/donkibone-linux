# Celestia ISO build settings. Sourced by build.sh and scripts/*.sh.
#
# Pinned upstream versions live next to the code that uses them:
#   pkgbuilds/caelestia-shell/PKGBUILD    caelestia shell release
#   pkgbuilds/caelestia-cli/PKGBUILD      caelestia cli release
#   pkgbuilds/quickshell-git/PKGBUILD     quickshell commit
#   pkgbuilds/qt6-m3shapes-git/PKGBUILD   m3shapes commit
#   pkgbuilds/celestia-system/PKGBUILD    caelestia dots commit

ISO_NAME="celestia"
ISO_PUBLISHER="Celestia (CachyOS + caelestia)"

# Where heavy build artifacts go. Must be on a Linux filesystem (not /mnt/c),
# mkarchiso needs real permissions and symlinks.
WORK_DIR="${WORK_DIR:-$HOME/celestia-work}"

# Local pacman repo with packages we build ourselves (AUR + pinned PKGBUILDs).
# scripts/setup-build-env.sh registers it in the host pacman.conf.
LOCAL_REPO_DIR="${LOCAL_REPO_DIR:-/var/cache/celestia-repo}"
LOCAL_REPO_NAME="${LOCAL_REPO_NAME:-celestia}"

# Online updates: the GitHub repository whose Releases host the signed pacman
# repositories ([celestia-stable], [celestia-beta], [celestia-dev]).
CELESTIA_REPO="${CELESTIA_REPO:-Nazarik322/donkibone-linux}"
# Update channel the ISO follows after installation: stable | beta | dev.
# Empty = derived from the git branch (main -> stable, beta -> beta, else dev).
CELESTIA_CHANNEL="${CELESTIA_CHANNEL:-}"

# CachyOS package optimization level of the image:
#   v3       faster, needs a CPU with x86-64-v3 (Intel Haswell 2013+, AMD Zen / Excavator+).
#            On older CPUs the USB stick will not even start.
#   generic  works on every 64-bit x86 CPU.
# Check the CPU on Linux: /lib/ld-linux-x86-64.so.2 --help | grep v3
CACHYOS_MARCH="v3"

# Time zone preselected in the installer (the user can change it there).
DEFAULT_TIMEZONE_REGION="Europe"
DEFAULT_TIMEZONE_ZONE="Moscow"
