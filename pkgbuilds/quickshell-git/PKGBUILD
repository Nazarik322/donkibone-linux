# Based on AUR quickshell-git (Maintainer: Entailz <entail-wraps0r at icloud dot com>).
# Celestia: source pinned to a commit tested with caelestia-shell 2.5.0.

_pkgname=quickshell
pkgname="$_pkgname-git"
_commit=2b4501a282689792b62e94f3fb30d8f512324fe6
pkgver=0.3.0
pkgrel=1
pkgdesc='Flexible toolkit for making desktop shells with QtQuick'
arch=(x86_64 aarch64)
url='https://git.outfoxxed.me/quickshell/quickshell'
options=(!strip)
license=('LGPL-3.0-only')
depends=(
  'qt6-declarative'
  'qt6-base'
  'jemalloc'
  'qt6-svg'
  'libpipewire'
  'libxcb'
  'wayland'
  'libdrm'
  'mesa'
  'cpptrace'
  'polkit'
)
makedepends=(
  'vulkan-headers'
  'spirv-tools'
  'qt6-shadertools'
  'wayland'
  'wayland-protocols'
  'cli11'
  'ninja'
  'cmake'
  'git'
)
provides=("$_pkgname")
conflicts=("$_pkgname")

_pkgsrc="$_pkgname"
source=("$_pkgsrc::git+$url.git#commit=$_commit"
  quickshell-check.hook)
sha256sums=('SKIP'
            'SKIP')

pkgver() {
  cd "$_pkgsrc"
  git describe --long --tags --abbrev=7 --exclude='*[a-zA-Z][a-zA-Z]*' \
    | sed -E 's/^[^0-9]*//;s/([^-]*-g)/r\1/;s/-/./g'
}

build() {
  cd "$_pkgname"
  cmake -GNinja -B build \
    -DCMAKE_BUILD_TYPE="RelWithDebInfo" \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DDISTRIBUTOR="Celestia (package: quickshell-git)" \
    -DINSTALL_QML_PREFIX=lib/qt6/qml

  cmake --build build
}

# celestia:qt-pinned
# Pin the Qt this package was built against (compiled QML/C++ is tied to it): pacman
# then refuses a Qt update until the package is rebuilt for the new version, and
# celestia-update explains the wait. Rebuilds are done automatically by CI.
_pin_qt() {
    local _p _v
    for _p in qt6-base qt6-declarative; do
        _v="$(pacman -Q "$_p" | cut -d' ' -f2)"
        depends+=("$_p=${_v%-*}")
    done
}

package() {
    _pin_qt
  install -Dm644 "quickshell-check.hook" -t "$pkgdir/usr/share/libalpm/hooks"
  cd "$_pkgname"
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "LICENSE" -t "$pkgdir/usr/share/licenses/$_pkgname"
}
