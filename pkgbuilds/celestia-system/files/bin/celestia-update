#!/usr/bin/env bash
# Full system update that keeps caelestia working.
#   1. CachyOS/Arch packages (kernel, drivers, Qt, Hyprland) through pacman.
#   2. AUR packages (caelestia, quickshell, fonts) through paru.
#   3. If Qt or Hyprland changed, rebuilds the compiled caelestia pieces against
#      the new versions - a stale quickshell is the usual cause of a black screen.
set -euo pipefail

watched=(qt6-base qt6-declarative qt6-wayland hyprland)
rebuild=(qt6-m3shapes-git quickshell-git caelestia-shell)

before="$(pacman -Q "${watched[@]}" 2>/dev/null || true)"

sudo pacman -Syu
paru -Sua

after="$(pacman -Q "${watched[@]}" 2>/dev/null || true)"

if [[ "$before" != "$after" ]]; then
    echo ":: Qt or Hyprland was updated, rebuilding caelestia components..."
    paru -S --rebuild --noconfirm "${rebuild[@]}"
    echo ":: Done. Restart the shell with: caelestia shell -r"
fi
