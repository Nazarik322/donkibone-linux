# Based on AUR qt6-m3shapes-git (Maintainer: Soramane <soramane32 at gmail dot com>).
# Celestia: source pinned to a commit tested with caelestia-shell 2.5.0.

_pkgname='qt6-m3shapes'
pkgname="$_pkgname-git"
_commit=8a6fe8961749887d677700b6508e0c9249968b7e
pkgver=r38
pkgrel=1
pkgdesc='A Qt6 library for Material 3 Expressive shapes'
arch=('x86_64' 'aarch64')
url='https://github.com/soramanew/m3shapes'
license=('Apache-2.0')
depends=('qt6-base' 'qt6-declarative')
makedepends=('git' 'cmake' 'ninja' 'qt6-shadertools')
provides=($_pkgname)
conflicts=($_pkgname 'caelestia-shell<2.4.0')
source=("$pkgname::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/${pkgname}"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    cd "${srcdir}/${pkgname}"

    cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo -DCMAKE_INSTALL_PREFIX=/
    cmake --build build
}

# celestia:qt-pinned
# Pin the Qt this package was built against (compiled QML/C++ is tied to it): pacman
# then refuses a Qt update until the package is rebuilt for the new version, and
# celestia-update explains the wait. Rebuilds are done automatically by CI.
_pin_qt() {
    local _p _v
    for _p in qt6-base qt6-declarative; do
        _v="$(pacman -Q "$_p" | cut -d' ' -f2)"
        depends+=("$_p=${_v%-*}")
    done
}

package() {
    _pin_qt
    cd "${srcdir}/${pkgname}"

    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$_pkgname/LICENSE
}
